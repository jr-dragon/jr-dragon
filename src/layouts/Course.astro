---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "katex/dist/katex.min.css";

interface Props {
	title: string;
	description?: string;
	locale?: string;
	translations?: { locale: string; href: string }[];
}

const { title, description, locale = "zh-Hant", translations = [] } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={locale} class="dark" data-theme="dark">
	<head>
		<BaseHead title={title} />
		{description && <meta name="description" content={description} />}
		<link rel="canonical" href={canonicalURL} />
		{translations.map((translation) => (
			<link rel="alternate" hreflang={translation.locale} href={new URL(translation.href, Astro.site)} />
		))}
	</head>
	<body class="bg-background text-foreground">
		<Header />
		<main class="mx-auto w-full max-w-3xl space-y-8 px-6 py-12">
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style>
	main :global(.typography-prose > :not(:first-child)) {
		margin-top: 1.5rem;
	}
	main :global(pre > code) {
		padding: 0;
		background: transparent;
	}
	main :global(.astro-code > code) {
		display: block;
		width: max-content;
		min-width: 100%;
		counter-reset: code-line;
	}
	main :global(.astro-code .line::before) {
		content: counter(code-line) / "";
		counter-increment: code-line;
		display: inline-block;
		min-width: 3ch;
		margin-right: 1.5ch;
		padding-right: 1.5ch;
		border-right: 1px solid var(--separator);
		color: var(--muted);
		text-align: right;
		user-select: none;
	}
	main :global(.course-code-block) {
		overflow: hidden;
		border: 1px solid var(--separator);
		border-radius: var(--radius-xl);
		background: var(--surface);
	}
	main :global(.course-code-block > figcaption) {
		padding: 0.75rem 1rem;
		border-bottom: 1px solid var(--separator);
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.875rem;
		overflow-wrap: anywhere;
	}
	main :global(.course-code-block > pre) {
		margin: 0;
		border-radius: 0;
	}
	main :global(table) {
		display: block;
		overflow-x: auto;
	}
	main :global(th),
	main :global(td) {
		padding: 0.5rem 1rem;
		border: 1px solid var(--separator);
	}
</style>
