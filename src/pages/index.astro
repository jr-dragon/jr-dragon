---
import { getCollection } from "astro:content";
import "../styles/global.css";
import { buttonVariants, Typography } from "@heroui/react";
import { List } from "lucide-react";
import githubLogo from "../assets/github-invertocat-white-clearspace.svg";
import BaseHead from "../components/BaseHead.astro";
import CourseMenu from "../components/CourseMenu";
import { getCourseTitle } from "../config/courses";
import { groupCourseChapters } from "../utils/course";

const posts = await getCollection("blog");
const courseEntries = await getCollection("course");
const courses = groupCourseChapters(courseEntries).map((course) => ({
	id: course.name,
	title: getCourseTitle(course.name),
	href: course.href,
}));
const directoryDate = posts
	.map(({ data }) => data.updatedDate ?? data.pubDate)
	.sort((a, b) => b.valueOf() - a.valueOf())
	.at(0);
const courseDirectoryDate = courseEntries
	.map(({ data }) => data.pubDate)
	.sort((a, b) => b.valueOf() - a.valueOf())
	.at(0);

function formatDirectoryDate(date: Date | undefined) {
	if (!date) return "";
	const dateParts = new Intl.DateTimeFormat("en-US", {
		timeZone: "Asia/Taipei",
		month: "2-digit",
		day: "2-digit",
		year: "numeric",
		hour: "2-digit",
		minute: "2-digit",
		second: "2-digit",
		hourCycle: "h23",
	}).formatToParts(date);
	const datePart = (type: Intl.DateTimeFormatPartTypes) =>
		dateParts.find((part) => part.type === type)?.value;
	return `${datePart("year")}-${datePart("month")}-${datePart("day")} ${datePart("hour")}:${datePart("minute")}:${datePart("second")}`;
}

const directoryDateText = formatDirectoryDate(directoryDate);
const courseDirectoryDateText = formatDirectoryDate(courseDirectoryDate);
---
<html lang="zh-Hant" class="dark" data-theme="dark">
	<head>
		<BaseHead title="芥龍"/>
	</head>
	<body class="bg-background text-foreground">
		<main class="flex min-h-svh items-center px-6 py-16 sm:px-10 lg:px-12">
			<div class="mx-auto grid w-full max-w-6xl items-center gap-12 lg:grid-cols-2 lg:gap-16">
				<section
					aria-label="Terminal"
					class="order-2 min-w-0 overflow-hidden rounded-2xl border border-border bg-surface lg:order-1"
				>
					<div class="flex h-10 items-center gap-2 border-b border-separator bg-default px-4" aria-hidden="true">
						<span class="size-3 rounded-full bg-danger"></span>
						<span class="size-3 rounded-full bg-warning"></span>
						<span class="size-3 rounded-full bg-success"></span>
					</div>
					<div class="min-h-64 overflow-x-auto p-4 font-mono sm:min-h-80 lg:min-h-96">
						<div class="text-[#528BFF]">$ whoami</div>
						<div class="text-[#9CA3AF]">j.dragon</div>
						<div><br></div>
						<div class="text-[#32D74B]">$ ls -l</div>
						<a href="/blog/" class="block w-max whitespace-nowrap rounded-sm decoration-[#9CA3AF] underline-offset-4 hover:underline focus-visible:underline focus-visible:outline-2 focus-visible:outline-focus focus-visible:outline-offset-2">
							<span class="text-[#9CA3AF]">dr--r--r--</span>{" "}
							{directoryDate && <time datetime={directoryDate.toISOString()} class="text-[rgb(0,215,0)]">{directoryDateText}</time>}{" "}<span class="text-[rgb(170,170,239)]">articles/</span>
						</a>
						<button
							id="terminal-courses-trigger"
							type="button"
							aria-controls="terminal-courses-output"
							aria-expanded="false"
							class="block w-max cursor-pointer whitespace-nowrap rounded-sm text-left decoration-[#9CA3AF] underline-offset-4 hover:underline focus-visible:underline focus-visible:outline-2 focus-visible:outline-focus focus-visible:outline-offset-2"
						>
							<span class="text-[#9CA3AF]">dr--r--r--</span>{" "}
							{courseDirectoryDate && <time datetime={courseDirectoryDate.toISOString()} class="text-[rgb(0,215,0)]">{courseDirectoryDateText}</time>}{" "}<span class="text-[rgb(170,170,239)]">courses/</span>
						</button>
						<div><br></div>
						<div id="terminal-courses-output" aria-live="polite" hidden>
							<div class="text-[#FFD60A]">
								<span aria-hidden="true">$ <span id="terminal-courses-command"></span></span>
								<span class="sr-only">$ ls -l courses/</span>
							</div>
							<ul id="terminal-courses-list" aria-label="課程列表" hidden>
								{courses.map((course) => (
									<li>
										<a href={course.href} aria-label={course.title} class="block w-max whitespace-nowrap rounded-sm text-[rgb(170,170,239)] underline-offset-4 hover:underline focus-visible:underline focus-visible:outline-2 focus-visible:outline-focus focus-visible:outline-offset-2">
											{course.id}/
										</a>
									</li>
								))}
							</ul>
						</div>
					</div>
				</section>
				<section aria-labelledby="hero-title" class="order-1 space-y-6 lg:order-2">
					<Typography type="h1" id="hero-title">
						安安，我是<span class="text-accent">芥龍</span>。
					</Typography>
					<Typography type="body" color="muted" className="max-w-sm">
						在繁華似錦的浮世留下一抹足跡，<br>
						願你能在此地能夠獲得片刻喘息。
					</Typography>
					<div class="flex flex-col items-start gap-4">
						<div class="flex flex-wrap items-center gap-3">
							<a href="/blog/" class={buttonVariants({ variant: "primary" })}>
								<List size={20} aria-hidden="true" />
								文章
							</a>
							<CourseMenu courses={courses} client:load />
						</div>
						<a href="https://github.com/jr-dragon" aria-label="GitHub" class={buttonVariants({ variant: "outline", isIconOnly: true, className: "github-button" })}>
							<img src={githubLogo.src} alt="" aria-hidden="true" width="28" height="28" class="size-7 shrink-0" />
						</a>
					</div>
				</section>
			</div>
		</main>
	</body>
</html>

<script>
	const trigger = document.querySelector<HTMLButtonElement>("#terminal-courses-trigger");
	const output = document.querySelector<HTMLDivElement>("#terminal-courses-output");
	const command = document.querySelector<HTMLSpanElement>("#terminal-courses-command");
	const list = document.querySelector<HTMLUListElement>("#terminal-courses-list");
	const commandText = "ls -l courses/";
	let typingTimeout: ReturnType<typeof setTimeout> | undefined;

	trigger?.addEventListener("click", () => {
		if (!output || !command || !list) return;

		clearTimeout(typingTimeout);
		trigger.setAttribute("aria-expanded", "true");
		output.setAttribute("aria-busy", "true");
		output.hidden = false;
		list.hidden = true;
		command.textContent = "";
		let characterCount = 0;

		function typeNextCharacter() {
			if (!output || !command || !list) return;

			characterCount += 1;
			command.textContent = commandText.slice(0, characterCount);
			if (characterCount < commandText.length) {
				typingTimeout = setTimeout(typeNextCharacter, 65);
			} else {
				list.hidden = false;
				output.setAttribute("aria-busy", "false");
			}
		}

		if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
			characterCount = commandText.length;
		}
		typeNextCharacter();
	});
</script>

<style>
	.github-button {
		--button-bg: #101411;
		--button-bg-hover: #232925;
		--button-bg-pressed: #101411;
		--button-fg: #fff;
		border-color: #909692;
	}

	.github-button:focus-visible {
		outline: 2px solid #fff;
		outline-offset: 3px;
	}
</style>
